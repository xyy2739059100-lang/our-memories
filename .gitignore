# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local debug screenshots & headless browser temp profiles (never ship these)
/*.png
/.edge-*

# 云端存档（只存在服务器上，不进仓库）
/data

/dist/

/build.sh

/run.sh

/execution-config.json

/.edge-*

# local deploy bundle
our-memories-deploy.zip

# local push helper (never commit)
/push-via-api.ps1
/deploy-github.ps1
